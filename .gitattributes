# Normalize line endings; the repository stores text files with LF.
* text=auto

# Source and project files
*.cs text diff=csharp
*.axaml text
*.csproj text
*.props text
*.slnx text
*.manifest text
*.json text
*.yml text
*.md text
*.ps1 text
*.nsi text

# Binaries
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.webp binary
*.exe binary
*.dll binary
*.pdb binary
*.pfx binary
*.snk binary
*.zip binary
*.7z binary
*.db binary

# GitHub linguist
**/packages.lock.json linguist-generated=true -diff
docs/** linguist-documentation
*.axaml linguist-language=XML
