            <StreamGeometry x:Key="IconGrid">M3,11H11V3H3M3,21H11V13H3M13,21H21V13H13M13,3V11H21V3</StreamGeometry>
            <StreamGeometry x:Key="IconList">M3,5H21V7H3V5M3,11H21V13H3V11M3,17H21V19H3V17Z</StreamGeometry>
            <StreamGeometry x:Key="IconUpdate">M21,10.12H14.22L16.96,7.3C14.23,4.6 9.81,4.5 7.08,7.2C4.35,9.91 4.35,14.28 7.08,17C9.81,19.7 14.23,19.7 16.96,17C18.32,15.65 19,14.08 19,12.1H21C21,14.08 20.12,16.65 18.36,18.39C14.85,21.87 9.15,21.87 5.64,18.39C2.14,14.92 2.11,9.28 5.62,5.81C9.13,2.34 14.76,2.34 18.27,5.81L21,3V10.12M12.5,8V12.25L16,14.33L15.28,15.54L11,13V8H12.5Z</StreamGeometry>

            <!-- Единая геометрия продукта. -->
            <CornerRadius x:Key="CardRadius">18</CornerRadius>
            <CornerRadius x:Key="HeroRadius">24</CornerRadius>
            <CornerRadius x:Key="ButtonRadius">12</CornerRadius>
            <CornerRadius x:Key="InputRadius">12</CornerRadius>
            <CornerRadius x:Key="BadgeRadius">999</CornerRadius>
            <Thickness x:Key="PagePadding">32,28,32,32</Thickness>
            <!-- Масштабируемые токены основной типографики. Значения обновляет App.ApplyUiPreferences. -->
            <x:Double x:Key="UiBodyFontSize">15</x:Double>
            <x:Double x:Key="UiH1FontSize">30</x:Double>
            <x:Double x:Key="UiH2FontSize">20</x:Double>
            <x:Double x:Key="UiDisplayFontSize">34</x:Double>
            <x:Double x:Key="UiDisplayLineHeight">40</x:Double>
            <x:Double x:Key="UiSectionFontSize">18</x:Double>
            <x:Double x:Key="UiEyebrowFontSize">11</x:Double>
            <x:Double x:Key="UiBodyLargeFontSize">16</x:Double>
            <x:Double x:Key="UiBodyLineHeight">24</x:Double>
            <x:Double x:Key="UiCaptionFontSize">13.5</x:Double>
            <x:Double x:Key="UiControlMinHeight">44</x:Double>
            <x:Double x:Key="UiCheckMinHeight">40</x:Double>
            <x:Double x:Key="UiInputFontSize">15</x:Double>
            <Thickness x:Key="UiButtonPadding">16,9</Thickness>
            <!-- Fluent: толщина рамки инпута в фокусе (цвет — в темах выше) -->
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ===== Базовая типографика ===== -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiBodyFontSize}" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="{DynamicResource UiH1FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="-0.65" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="{DynamicResource UiH2FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="-0.3" />
        </Style>
        <Style Selector="TextBlock.display">
            <Setter Property="FontSize" Value="{DynamicResource UiDisplayFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="-0.9" />
            <Setter Property="LineHeight" Value="{DynamicResource UiDisplayLineHeight}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="{DynamicResource UiSectionFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="-0.2" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="{DynamicResource UiEyebrowFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.bodyLarge">
            <Setter Property="FontSize" Value="{DynamicResource UiBodyLargeFontSize}" />
            <Setter Property="LineHeight" Value="{DynamicResource UiBodyLineHeight}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource UiCaptionFontSize}" />
        </Style>
        <!-- Моноширинный класс для путей файлов; :is() — чтобы ловить и SelectableTextBlock -->
        <Style Selector=":is(TextBlock).mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Courier New,monospace" />
        </Style>

        <!-- ===== Карточка ===== -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        </Style>
        <Style Selector="Border.cardFlat">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.hero">
            <Setter Property="Background" Value="{DynamicResource HeroGradient}" />
            <Setter Property="CornerRadius" Value="{StaticResource HeroRadius}" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="BoxShadow" Value="{DynamicResource ElevatedShadow}" />
        </Style>
        <Style Selector="Border.iconTile">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>

        <!-- Компактная, но хорошо читаемая строка преимущества на welcome-экране. -->
        <Style Selector="Border.onboardingBenefit">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <!-- ===== Бейдж/чип: единый радиус и внутренние отступы ===== -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="{StaticResource BadgeRadius}" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ===== Строка списка: прозрачная, ховер со скруглением 8 ===== -->
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
        </Style>

        <!-- ===== Кнопки ===== -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="{StaticResource ButtonRadius}" />
            <Setter Property="Padding" Value="{DynamicResource UiButtonPadding}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="{DynamicResource UiBodyFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource UiControlMinHeight}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.985)" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.008)" />
        </Style>
        <Style Selector="Button:pointerover:pressed">
            <Setter Property="RenderTransform" Value="scale(0.985)" />
        </Style>
        <!-- Reduced motion: цветовые состояния остаются, геометрическое движение отключается. -->
        <Style Selector="Window.reduceMotion Button:pointerover">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Window.reduceMotion Button:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Window.reduceMotion Button.toolTile:pointerover">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Window.reduceMotion Button.toolTile:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Window.reduceMotion Border.fileTile:pointerover">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="46" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGradientHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        </Style>
        <!-- Единый источник цвета контента цветных кнопок. Вложенные TextBlock/PathIcon
             не наследуют Foreground кнопки — раньше это давало тёмный текст на синем и требовало
             ~15 ручных Foreground="White" по вьюхам; тёмная тема ломала половину из них. -->
        <Style Selector="Button.primary TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        </Style>
        <Style Selector="Button.primary PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerForeground}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.danger TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerForeground}" />
        </Style>
        <Style Selector="Button.danger PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DangerForeground}" />
        </Style>
        <!-- «Красные» кнопки не сереют при наведении/нажатии (дефолтный Fluent перекрашивал фон) -->
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.tonal">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.tonal TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.tonal PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.iconButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!-- ===== Иконки ===== -->
        <Style Selector="PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>

        <!-- ===== Навигация продукта ===== -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="MinHeight" Value="46" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SidebarHover}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SidebarSelected}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SidebarAccent}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:not(:selected) PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:not(:selected) TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
        </Style>

        <!-- ===== Инпуты: радиус 10, комфортная высота; фокус — 2px акцентная рамка
             (через переопределение Fluent-ресурсов TextControlBorder* выше) ===== -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="{StaticResource InputRadius}" />
            <Setter Property="MinHeight" Value="{DynamicResource UiControlMinHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource UiInputFontSize}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="{StaticResource InputRadius}" />
            <Setter Property="MinHeight" Value="{DynamicResource UiControlMinHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource UiInputFontSize}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="{StaticResource InputRadius}" />
            <Setter Property="MinHeight" Value="{DynamicResource UiControlMinHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource UiInputFontSize}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="{DynamicResource UiCheckMinHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource UiInputFontSize}" />
        </Style>

        <!-- ===== Вкладки: компактнее гигантского pivot-заголовка Fluent ===== -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ===== Прогресс ===== -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentGradient}" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Application.Styles>
</Application>
