<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Deduplicator.App"
             x:Class="Deduplicator.App.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- ===== Светлая продуктовая тема ===== -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F4F6FB" />
                    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceAlt" Color="#EEF2F8" />
                    <SolidColorBrush x:Key="SurfaceStrong" Color="#E4EAF3" />
                    <SolidColorBrush x:Key="SurfaceBorder" Color="#DCE3ED" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#151B28" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#5E697A" />
                    <SolidColorBrush x:Key="TextTertiary" Color="#8792A3" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#4854D6" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#ECEEFF" />
                    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#101624" />
                    <SolidColorBrush x:Key="SidebarSurface" Color="#171F31" />
                    <SolidColorBrush x:Key="SidebarText" Color="#F7F9FC" />
                    <SolidColorBrush x:Key="SidebarTextMuted" Color="#9EA9BC" />
                    <SolidColorBrush x:Key="SidebarHover" Color="#1B263C" />
                    <SolidColorBrush x:Key="SidebarSelected" Color="#273454" />
                    <SolidColorBrush x:Key="SidebarAccent" Color="#91A0FF" />
                    <SolidColorBrush x:Key="HoverBackground" Color="#E9EEF6" />
                    <SolidColorBrush x:Key="SelectedBackground" Color="#ECEEFF" />
                    <SolidColorBrush x:Key="CardBorder" Color="#E1E7F0" />
                    <BoxShadows x:Key="CardShadow">0 1 2 0 #100F172A, 0 10 32 0 #0A0F172A</BoxShadows>
                    <BoxShadows x:Key="ElevatedShadow">0 2 6 0 #140F172A, 0 18 48 0 #120F172A</BoxShadows>
                    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#5662DD" />
                        <GradientStop Offset="1" Color="#3F49BD" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#5C67DC" />
                        <GradientStop Offset="1" Color="#4B55CC" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#17233B" />
                        <GradientStop Offset="0.58" Color="#293A68" />
                        <GradientStop Offset="1" Color="#5352C8" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4854D6" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C9363E" />
                    <SolidColorBrush x:Key="DangerForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#087A5A" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#A65A00" />
                    <!-- Мягкие статусные подложки (баннеры/плашки) и фиолетовый
                         акцент («Архив дисков», категория «Документы») — раньше хардкоды в вьюхах. -->
                    <SolidColorBrush x:Key="DangerSoft" Color="#FFF0F0" />
                    <SolidColorBrush x:Key="WarningSoft" Color="#FFF6E8" />
                    <SolidColorBrush x:Key="SuccessSoft" Color="#EAF8F2" />
                    <SolidColorBrush x:Key="IndigoBrush" Color="#4854D6" />
                    <SolidColorBrush x:Key="IndigoSoft" Color="#ECEEFF" />
                    <SolidColorBrush x:Key="PurpleBrush" Color="#8B5CF6" />
                    <!-- Затемнения диалогов/просмотрщика: полупрозрачный чёрный уместен в обеих
                         темах, но живёт в ресурсах для единообразия (и №7: подложка сайдбара). -->
                    <SolidColorBrush x:Key="OverlayDim" Color="#80000000" />
                    <SolidColorBrush x:Key="OverlayDimLight" Color="#33000000" />
                    <SolidColorBrush x:Key="OverlayDimStrong" Color="#E6000000" />
                </ResourceDictionary>
                <!-- ===== Тёмная продуктовая тема ===== -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#0E131B" />
                    <SolidColorBrush x:Key="SurfaceBackground" Color="#171E28" />
                    <SolidColorBrush x:Key="SurfaceRaised" Color="#1C2531" />
                    <SolidColorBrush x:Key="SurfaceAlt" Color="#202A37" />
                    <SolidColorBrush x:Key="SurfaceStrong" Color="#293646" />
                    <SolidColorBrush x:Key="SurfaceBorder" Color="#2A3646" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#F5F7FB" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#AAB5C5" />
                    <SolidColorBrush x:Key="TextTertiary" Color="#788598" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#AAB1FF" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#252B50" />
                    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#090E15" />
                    <SolidColorBrush x:Key="SidebarSurface" Color="#121A26" />
                    <SolidColorBrush x:Key="SidebarText" Color="#F7F9FC" />
                    <SolidColorBrush x:Key="SidebarTextMuted" Color="#8F9CAF" />
                    <SolidColorBrush x:Key="SidebarHover" Color="#182233" />
                    <SolidColorBrush x:Key="SidebarSelected" Color="#222D4A" />
                    <SolidColorBrush x:Key="SidebarAccent" Color="#9BA6FF" />
                    <SolidColorBrush x:Key="HoverBackground" Color="#253140" />
                    <SolidColorBrush x:Key="SelectedBackground" Color="#272E58" />
                    <SolidColorBrush x:Key="CardBorder" Color="#2A3646" />
                    <BoxShadows x:Key="CardShadow">0 1 2 0 #30000000, 0 12 32 0 #18000000</BoxShadows>
                    <BoxShadows x:Key="ElevatedShadow">0 4 12 0 #3D000000, 0 22 56 0 #26000000</BoxShadows>
                    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#5B66DE" />
                        <GradientStop Offset="1" Color="#444DBB" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#5D68D8" />
                        <GradientStop Offset="1" Color="#505ACA" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#171F34" />
                        <GradientStop Offset="0.6" Color="#252C58" />
                        <GradientStop Offset="1" Color="#494AA7" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#AAB1FF" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF7D83" />
                    <SolidColorBrush x:Key="DangerForeground" Color="#211016" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#45C99A" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F6AD55" />
                    <!-- Тёмные приглушённые версии мягких подложек -->
                    <SolidColorBrush x:Key="DangerSoft" Color="#3A2329" />
                    <SolidColorBrush x:Key="WarningSoft" Color="#3B3020" />
                    <SolidColorBrush x:Key="SuccessSoft" Color="#193A32" />
                    <SolidColorBrush x:Key="IndigoBrush" Color="#949DFF" />
                    <SolidColorBrush x:Key="IndigoSoft" Color="#272E58" />
                    <SolidColorBrush x:Key="PurpleBrush" Color="#B58BFF" />
                    <SolidColorBrush x:Key="OverlayDim" Color="#80000000" />
                    <SolidColorBrush x:Key="OverlayDimLight" Color="#33000000" />
                    <SolidColorBrush x:Key="OverlayDimStrong" Color="#E6000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

