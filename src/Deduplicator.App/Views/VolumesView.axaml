<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deduplicator.App.Localization"
             x:Class="Deduplicator.App.Views.VolumesView">

    <Panel>
        <ScrollViewer IsEnabled="{Binding !ShowRemoveConfirm}">
            <StackPanel Margin="{StaticResource PagePadding}" Spacing="20">
                <Border Classes="hero">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Classes="eyebrow" Text="МОИ НОСИТЕЛИ" Foreground="#E6E8FF"/>
                            <TextBlock Classes="display" Text="{x:Static loc:Strings.VolumesTitle}" Foreground="White"/>
                            <TextBlock Classes="bodyLarge" Text="{x:Static loc:Strings.VolumesSubtitle}"
                                       Foreground="White" Opacity="0.78" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="1" Classes="tonal" VerticalAlignment="Top"
                                Command="{Binding RefreshCommand}"
                                ToolTip.Tip="Обновить список подключённых и сохранённых дисков"
                                AutomationProperties.Name="Обновить список дисков"
                                AutomationProperties.HelpText="Заново проверяет подключённые и сохранённые носители">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconRefresh}"/>
                                <TextBlock Text="{x:Static loc:Strings.Refresh}"/>
                            </StackPanel>
                        </Button>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" Margin="0,24,0,0">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="caption" Text="{x:Static loc:Strings.TotalVolumes}" Foreground="White" Opacity="0.7"/>
                                <TextBlock FontSize="25" FontWeight="SemiBold" Text="{Binding TotalVolumes}" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3" Margin="24,0,0,0">
                                <TextBlock Classes="caption" Text="{x:Static loc:Strings.TotalFiles}" Foreground="White" Opacity="0.7"/>
                                <TextBlock FontSize="25" FontWeight="SemiBold" Text="{Binding TotalFilesText}" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3" Margin="24,0,0,0">
                                <TextBlock Classes="caption" Text="{x:Static loc:Strings.VolumeCapacity}" Foreground="White" Opacity="0.7"/>
                                <TextBlock FontSize="25" FontWeight="SemiBold" Text="{Binding TotalSizeText}" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="2,2,2,0">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="Диски и сохранённые каталоги"/>
                        <TextBlock Classes="muted" Text="Выберите носитель, чтобы проверить его или посмотреть запомненные файлы."
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="96" VerticalAlignment="Center"
                                 IsVisible="{Binding IsBusy}"/>
                </Grid>

                <Border Padding="14" CornerRadius="10" Background="{DynamicResource DangerSoft}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        AutomationProperties.LiveSetting="Assertive">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
                </Border>

                <ItemsControl x:Name="OnboardingVolumeList" ItemsSource="{Binding Volumes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="0,0,0,12">
                                <Grid RowDefinitions="Auto,Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="iconTile" VerticalAlignment="Top">
                                            <PathIcon Data="{StaticResource IconHdd}" Width="24" Height="24"
                                                      Foreground="{DynamicResource AccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="16,0,16,0" Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding DisplayName}" Classes="h2"/>
                                                <Border Classes="badge" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSoft}">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="caption" TextWrapping="Wrap">
                                                <Run Text="{x:Static loc:Strings.VolumeSerial}"/><Run Text=": "/><Run Text="{Binding Serial}"/>
                                                <Run Text="   ·   "/><Run Text="{x:Static loc:Strings.VolumeFs}"/><Run Text=": "/><Run Text="{Binding Fs}"/>
                                                <Run Text="   ·   "/><Run Text="{Binding CapacityText}"/>
                                            </TextBlock>
                                            <TextBlock Classes="bodyLarge" Text="{Binding SummaryLine}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Classes="primary" VerticalAlignment="Top"
                                                Command="{Binding $parent[ItemsControl].DataContext.ScanCommand}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding IsConnected}"
                                                AutomationProperties.Name="Проверить этот диск"
                                                AutomationProperties.HelpText="Открывает поиск дубликатов для выбранного носителя">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconSearch}"/>
                                                <TextBlock Text="{x:Static loc:Strings.ScanThisVolume}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <WrapPanel Grid.Row="1" Margin="62,18,0,0">
                                        <Button Classes="tonal" Margin="0,0,8,8"
                                                Command="{Binding $parent[ItemsControl].DataContext.ExploreCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{x:Static loc:Strings.NavExplorer}"
                                                AutomationProperties.Name="Посмотреть запомненные файлы">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconFolder}"/>
                                                <TextBlock Text="Файлы на диске"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="ghost" Margin="0,0,8,8"
                                                Command="{Binding $parent[ItemsControl].DataContext.OpenInExplorerCommand}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding IsConnected}"
                                                ToolTip.Tip="{x:Static loc:Strings.OpenInExplorer}"
                                                AutomationProperties.Name="Открыть диск в Проводнике">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconChevronRight}"/>
                                                <TextBlock Text="Открыть в Проводнике"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="ghost" Margin="0,0,8,8"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{x:Static loc:Strings.RemoveFromCatalog}"
                                                AutomationProperties.Name="Убрать диск из каталога">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconClose}" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="Убрать из списка" Classes="muted"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Подтверждение удаления носителя из каталога. -->
        <Border IsVisible="{Binding ShowRemoveConfirm}" Background="{DynamicResource OverlayDim}" ZIndex="100"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border Classes="card" MaxWidth="480" Margin="24"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Classes="iconTile" Background="{DynamicResource WarningSoft}">
                            <PathIcon Data="{StaticResource IconWarning}" Width="22" Height="22"
                                      Foreground="{DynamicResource WarningBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="h2" Text="{x:Static loc:Strings.RemoveFromCatalog}"/>
                            <TextBlock Classes="caption" Text="Сам диск и файлы останутся без изменений." Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.ConfirmRemoveVolume}" TextWrapping="Wrap" Classes="bodyLarge muted"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button x:Name="RemoveCancelButton" Command="{Binding CancelRemoveCommand}"
                                AutomationProperties.Name="Отменить удаление диска из каталога">
                            <TextBlock Text="{x:Static loc:Strings.Cancel}"/>
                        </Button>
                        <Button Classes="danger" Command="{Binding ConfirmRemoveCommand}"
                                AutomationProperties.Name="Подтвердить удаление диска из каталога">
                            <TextBlock Text="{x:Static loc:Strings.Delete}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
