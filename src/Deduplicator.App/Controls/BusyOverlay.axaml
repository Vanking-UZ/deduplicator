<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deduplicator.App.Localization"
             xmlns:conv="clr-namespace:Deduplicator.App.Converters"
             xmlns:controls="clr-namespace:Deduplicator.App.Controls"
             x:Class="Deduplicator.App.Controls.BusyOverlay"
             x:Name="Root" Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="Выполняется операция">

    <!-- Единый оверлей занятости — затемнение + карточка с анимированным лого.
         Свойства: Text (заголовок), SubText (опционально), CancelCommand (опционально —
         кнопка «Отмена» видна, только если команда задана). Плавное появление: Opacity
         привязан к IsVisible через ToOpacity + DoubleTransition (150 мс). IsVisible лого
         привязан к IsVisible оверлея, чтобы анимация не крутилась в скрытом состоянии. -->
    <Border Background="{DynamicResource OverlayDim}"
            Opacity="{Binding #Root.IsVisible, Converter={x:Static conv:Converters.ToOpacity}}">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Border.Transitions>
        <Border Classes="card" MinWidth="280" MaxWidth="440" Padding="28,26"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <controls:AnimatedLogo Size="64" HorizontalAlignment="Center"
                                       IsVisible="{Binding #Root.IsVisible}" />
                <TextBlock Text="{Binding #Root.Text}" FontWeight="SemiBold" FontSize="15"
                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="{Binding #Root.SubText}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           IsVisible="{Binding #Root.SubText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button HorizontalAlignment="Center" Command="{Binding #Root.CancelCommand}"
                        Content="{x:Static loc:Strings.Cancel}"
                        IsVisible="{Binding #Root.CancelCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
